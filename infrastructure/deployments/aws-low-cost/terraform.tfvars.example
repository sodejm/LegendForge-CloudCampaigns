  tunnel_token   = "REPLACE_WITH_TUNNEL_TOKEN"
  license_key    = "REPLACE_WITH_FOUNDRY_LICENSE"
  admin_password = "REPLACE_WITH_ADMIN_PASSWORD"
  username       = "REPLACE_WITH_FOUNDRY_USERNAME"
  password       = "REPLACE_WITH_FOUNDRY_PASSWORD"
}
