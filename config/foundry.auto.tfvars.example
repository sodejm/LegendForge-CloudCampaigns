# Hetzner-only example. Other deployments use their own README and examples.
# Copy to config/foundry.auto.tfvars; pass explicitly with -var-file.
foundry_hostname = "vtt.example.test"

# Configure the Cloudflare Tunnel route and optional Access policy separately.
# Pin reviewed container versions before deployment.
foundry_image_tag     = "14.367.0"
cloudflared_image_tag = "REPLACE_WITH_REVIEWED_VERSION"

# false DESTROYS BOTH server and managed data volume. Never use as a pause.
compute_enabled = true

# This only opens the firewall; it does not install an SSH public key.
# Arrange administrator access separately before enabling SSH.
admin_ssh_cidr = null

# Confirm current server availability and review the plan.
location            = "fsn1"
server_type         = "cx23"
data_volume_size_gb  = 20
